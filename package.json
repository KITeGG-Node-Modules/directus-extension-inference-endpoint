{
  "name": "@kitegg/directus-extension-inference-endpoint",
  "description": "Directus custom endpoint that issues personal LiteLLM API keys for the KITeGG inference service",
  "icon": "key",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-endpoint"
  ],
  "type": "module",
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^10.3.4"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "format": "prettier -w src/ test/",
    "lint": "eslint src/ test/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "10.3.4",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.2.5",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "kitegg-directus-extension-common": "github:KITeGG-Node-Modules/kitegg-directus-extension-common#466a81baf6efe700339df67aa5f51078e545837e"
  }
}
